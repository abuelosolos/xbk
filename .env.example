# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (use the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (Google Cloud Console > OAuth client; redirect URI: {APP_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Comma-separated emails that receive the "admin" role on sign-up
ADMIN_EMAILS=you@example.com

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Vercel Blob (admin product photo uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Resend (order emails). EMAIL_FROM must be on a verified domain, e.g. "XBK <orders@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=XBK <orders@example.com>

# Disposable Neon branch for `npm run test:stock` (writes data; must differ from DATABASE_URL)
# TEST_DATABASE_URL=postgres://...
