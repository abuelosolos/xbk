# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (use the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call auth (www, custom domains), comma-separated. Optional.
BETTER_AUTH_TRUSTED_ORIGINS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (Google Cloud Console > OAuth client; redirect URI: {APP_URL}/api/auth/callback/google)
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google  and  https://<your-domain>/api/auth/callback/google
# Set the consent screen to "In production" so any Google account can sign in.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Comma-separated emails that receive the "admin" role on sign-up
ADMIN_EMAILS=you@example.com

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Vercel Blob (admin product photo uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Resend (order emails). EMAIL_FROM must be on a verified domain, e.g. "XBK <orders@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=XBK <orders@example.com>

# Disposable Neon branch for `npm run test:stock` (writes data; must differ from DATABASE_URL)
# TEST_DATABASE_URL=postgres://...

# Production builds run pending migrations first (automatic on Vercel). On other hosts set MIGRATE_ON_BUILD=1 to get the same.
# MIGRATE_ON_BUILD=1
